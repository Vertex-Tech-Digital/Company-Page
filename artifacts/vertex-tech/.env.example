# --- Base de Datos (Neon PostgreSQL) ---
DATABASE_URL=postgresql://usuario:contraseña@host/neondb?sslmode=require

# --- Auth del panel admin ---
# Secreto para firmar/verificar los JWT de sesión (ver api/_auth.js).
# Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# La contraseña del admin NO es una env var de la app — vive hasheada
# (bcrypt) en admin_users. Para crear/rotarla:
#   cd lib/db && ADMIN_USERNAME="usuario" ADMIN_PASSWORD="contraseña_real_y_larga" pnpm run seed

# --- Email (Nodemailer SMTP) ---
GMAIL_USER=tu_correo@gmail.com
GMAIL_APP_PASSWORD=tu_contraseña_de_aplicacion_gmail

# --- Notificaciones Internas ---
# También recibe la alerta de intentos fallidos de login admin (api/_admin/login.js),
# que solo funciona con Vercel KV configurado (ver Rate Limiting más abajo).
EMAIL_INTERNAL_NOTIFICATION=correo_donde_recibir_alertas@empresa.com

# --- Datos Legales e Identificación Fiscal ---
VITE_COMPANY_TAX_ID="Y0000000X"
VITE_COMPANY_HOLDER="Nombre de la Empresa o Titular Legal"
VITE_CONTACT_EMAIL="contacto@tudominio.com"
VITE_CONTACT_PHONE="+34 600 000 000"
VITE_WHATSAPP_NUMBER="34600000000"

# --- Datos Bancarios (Transferencia bancaria) ---
VITE_BANK_BENEFICIARY="Nombre de la Empresa o Titular"
VITE_BANK_NAME="Nombre del Banco (ej: BBVA)"
VITE_BANK_IBAN="ESXX XXXX XXXX XXXX XXXX XXXX"
VITE_BANK_BIC="XXXXXXXXXXX"

# --- Rate Limiting (Vercel KV / Upstash Redis) ---
KV_REST_API_URL=https://xxxxxxxx.kv.vercel-storage.com
KV_REST_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Diagnóstico IA (solo servidor) ---
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=25000
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OPENROUTER_TIMEOUT_MS=25000
OPENROUTER_SITE_URL=https://vertextechdigital.com
