{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "functions": {
    "api/diagnostico.js": {
      "maxDuration": 15,
      "memory": 1024
    }
  },
  "redirects": [
    { "source": "/tarjeta", "destination": "/#servicios", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/api/admin-:action",
      "destination": "/api/admin?action=:action"
    },
    {
      "source": "/api/invoices/create",
      "destination": "/api/admin?action=invoices-create"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
