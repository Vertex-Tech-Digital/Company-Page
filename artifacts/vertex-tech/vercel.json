{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "functions": {
    "api/diagnostico.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "redirects": [
    { "source": "/tarjeta", "destination": "/#servicios", "permanent": false }
  ],
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
