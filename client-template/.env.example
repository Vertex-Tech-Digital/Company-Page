# Variables del cliente. Copia este archivo a `.env` y rellena según el proyecto.
# Las variables expuestas al navegador DEBEN empezar por VITE_.

# Ejemplo: endpoint del formulario de contacto (si se añade backend/serverless).
# VITE_CONTACT_ENDPOINT=/api/contact

# Ejemplo: ID de analítica.
# VITE_ANALYTICS_ID=
